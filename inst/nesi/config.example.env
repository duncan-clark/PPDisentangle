# Copy to inst/nesi/nesi.env (gitignored) or ~/.config/ppdisentangle/nesi.env
#
# SECURITY: This file and all other *.env files under inst/nesi/ are gitignored.
# Do not commit credentials. Prefer SSH keys over passwords; if you must store
# a token here, keep it only in nesi.env (never in config.example.env).

# NeSI login (Mahuika)
PP_NESI_USER="your_username"
PP_NESI_HOST="mahuika.nesi.org.nz"

# Remote clone on NeSI (use an absolute path)
PP_NESI_REMOTE_PKG="/nesi/home/users/${PP_NESI_USER}/PPDisentangle"

# Cluster-side canonical outputs (project space recommended)
PP_NESI_REMOTE_OUTPUT="/nesi/project/uoo04008/PPDisentangle-output"

# Branch to pull on NeSI before submit (default: your local current branch)
# PP_GIT_BRANCH="major-revisions-cleanup"

# Push local branch to origin before remote submit
# PP_NESI_PUSH=1
